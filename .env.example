# Valores exclusivamente locais. Copie para .env e altere se necessário.
POSTGRES_DB=falapet
POSTGRES_USER=falapet
POSTGRES_PASSWORD=falapet_local
POSTGRES_PORT=5432
APP_PORT=8080
# Segredos de assinatura e autenticação devem ser definidos fora deste arquivo.
# CURSOR_SIGNING_KEY=<valor-local-com-ao-menos-32-bytes>
# AUTH_TOKEN_HASH_KEY=<valor-aleatorio-com-ao-menos-32-bytes>
# AUTH_IDEMPOTENCY_ENCRYPTION_KEY=<valor-aleatorio-com-exatamente-32-bytes>
